# Example variable names ONLY. Set real values in Render > Web Service > Environment.
# NEVER commit a filled .env file or share passwords in messages.
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_PASSWORD@YOUR_RENDER_INTERNAL_HOST/YOUR_DATABASE_NAME
SRS_DEPLOYMENT_MODE=production
SRS_SECRET_KEY=GENERATE_WITH_python_secrets_token_urlsafe_48
SRS_STATION_TOKEN=GENERATE_ANOTHER_DIFFERENT_RANDOM_SECRET
SRS_HTTPS=1
SRS_PUBLIC_URL=https://YOUR-REAL-SERVICE.onrender.com
# Set these ONLY for initial deployment then REMOVE after first login:
SRS_INITIAL_OPERATOR_USER=your_operator_username
SRS_INITIAL_OPERATOR_PASSWORD=YOUR_OWN_STRONG_PASSWORD_12_CHARS_MIN
